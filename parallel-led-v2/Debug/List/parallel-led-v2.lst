                 ;
                 ;// Global flag used to signal that 10ms have elapsed
                 ;volatile unsigned char timer1_flag = 0;
                 ;
                 ;// Timer1 Compare Match A Interrupt Service Routine
                 ;interrupt [TIM1_COMPA] void timer1_compa_isr(void)
                 ; 0000 0012 {
                 _timer1_compa_isr:
                 ; .FSTART _timer1_compa_isr
00005d 93ea      	ST   -Y,R30
                 ; 0000 0013     timer1_flag = 1;  // Set flag when compare match occurs (10ms elapsed)
00005e e0e1      	LDI  R30,LOW(1)
00005f 93e0 0270 	STS  _timer1_flag,R30
                 ; 0000 0014 }
000061 91e9      	LD   R30,Y+
000062 9518      	RETI
                 ; .FEND
                 ;
                 ;// Function to create a ~10ms delay using Timer1 and sleep (Idle mode)
                 ;void sleep_timer1_ms(int x)
                 ; 0000 0018 {
                 _sleep_timer1_ms:
                 ; .FSTART _sleep_timer1_ms
                 ; 0000 0019     timer1_flag = 0;  // Clear the flag
000063 93ba      	ST   -Y,R27
000064 93aa      	ST   -Y,R26
                 ;	x -> Y+0
000065 e0e0      	LDI  R30,LOW(0)
000066 93e0 0270 	STS  _timer1_flag,R30
                 ; 0000 001A 
                 ; 0000 001B     // --- Configure Timer1 in CTC Mode ---
                 ; 0000 001C     // WGM12: CTC mode, and CS11: prescaler of 8.
                 ; 0000 001D     // With an 8MHz clock and prescaler 8, Timer1 ticks at 1MHz (1µs per tick).
                 ; 0000 001E     // For a 10ms delay, we need 10,000 ticks (0 to 9999).
                 ; 0000 001F     TCCR1A = 0x00;                        // Normal port operation
000068 bdef      	OUT  0x2F,R30
                 ; 0000 0020     TCCR1B = (1 << WGM12) | (1 << CS11);    // CTC mode with prescaler = 8
000069 e0ea      	LDI  R30,LOW(10)
00006a bdee      	OUT  0x2E,R30
                 ; 0000 0021     TCNT1  = 0;                           // Reset Timer1 counter
00006b e0e0      	LDI  R30,LOW(0)
00006c e0f0      	LDI  R31,HIGH(0)
00006d bdfd      	OUT  0x2C+1,R31
00006e bdec      	OUT  0x2C,R30
                 ; 0000 0022     OCR1A  = 999 * x;                        // Set compare value to 9999 for 10ms
00006f 81e8      	LD   R30,Y
000070 81f9      	LDD  R31,Y+1
000071 eea7      	LDI  R26,LOW(999)
000072 e0b3      	LDI  R27,HIGH(999)
000073 940e 0201 	CALL __MULW12
000075 bdfb      	OUT  0x2A+1,R31
000076 bdea      	OUT  0x2A,R30
                 ; 0000 0023 
                 ; 0000 0024     // Enable Timer1 Compare Match A interrupt
                 ; 0000 0025     TIMSK |= (1 << OCIE1A);
000077 b7e9      	IN   R30,0x39
000078 61e0      	ORI  R30,0x10
000079 bfe9      	OUT  0x39,R30
                 ; 0000 0026 
                 ; 0000 0027     // --- Set Up Idle Sleep Mode Manually ---
                 ; 0000 0028     // For Idle mode on the ATmega32, the sleep mode bits (SM0 and SM1 in MCUCR)
                 ; 0000 0029     // should be 0. Then, set the Sleep Enable (SE) bit to allow sleeping.
                 ; 0000 002A     MCUCR &= ~((1 << SM0) | (1 << SM1));  // Select Idle mode (SM1=0, SM0=0)
00007a b7e5      	IN   R30,0x35
00007b 7cef      	ANDI R30,LOW(0xCF)
00007c bfe5      	OUT  0x35,R30
                 ; 0000 002B     MCUCR |= (1 << SE);                   // Enable sleep mode
00007d b7e5      	IN   R30,0x35
00007e 68e0      	ORI  R30,0x80
00007f bfe5      	OUT  0x35,R30
                 ; 0000 002C 
                 ; 0000 002D     // Wait until Timer1 Compare Match A interrupt sets the flag.
                 ; 0000 002E     while(!timer1_flag)
                 _0x4:
000080 91e0 0270 	LDS  R30,_timer1_flag
000082 30e0      	CPI  R30,0
000083 f411      	BRNE _0x6
                 ; 0000 002F     {
                 ; 0000 0030         // Execute the sleep instruction. In Idle mode, Timer1 keeps running.
                 ; 0000 0031         #asm("sleep");
000084 9588      	sleep
                 ; 0000 0032     }
000085 cffa      	RJMP _0x4
                 _0x6:
                 ; 0000 0033 
                 ; 0000 0034     // After waking, disable sleep.
                 ; 0000 0035     MCUCR &= ~(1 << SE);
000086 b7e5      	IN   R30,0x35
000087 77ef      	ANDI R30,0x7F
000088 bfe5      	OUT  0x35,R30
                 ; 0000 0036 
                 ; 0000 0037     // --- Stop Timer1 ---
                 ; 0000 0038     TIMSK &= ~(1 << OCIE1A);  // Disable Timer1 Compare Match A interrupt
000089 b7e9      	IN   R30,0x39
00008a 7eef      	ANDI R30,0xEF
00008b bfe9      	OUT  0x39,R30
                 ; 0000 0039     TCCR1B = 0;              // Stop Timer1 by clearing its clock source
00008c e0e0      	LDI  R30,LOW(0)
00008d bdee      	OUT  0x2E,R30
                 ; 0000 003A }
00008e 9622      	ADIW R28,2
00008f 9508      	RET
                 ; .FEND
